<Window x:Class="WinEyes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinEyes"
        Height="150"
        Width="300"
        MinWidth="60"
        MinHeight="30"
        MaxWidth="900"
        MaxHeight="450"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp"
        LostMouseCapture="Window_LostMouseCapture">
    <Grid Background="Transparent">
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="designCanvas"
                    Width="300"
                    Height="150"
                    Background="Transparent">
                <Grid x:Name="leftEye"
                      Canvas.Left="10"
                      Canvas.Top="10"
                      Width="120"
                      Height="120">
                    <Ellipse x:Name="leftEyeBackground"
                             Fill="White"
                             Stroke="Black"
                             StrokeThickness="2"/>
                    <Canvas x:Name="leftPupilCanvas"
                            Width="120"
                            Height="120">
                        <Ellipse x:Name="leftEyePupil"
                                 Width="40"
                                 Height="40"
                                 Fill="Black"
                                 Canvas.Left="40"
                                 Canvas.Top="40"/>
                    </Canvas>
                </Grid>

                <Grid x:Name="rightEye"
                      Canvas.Left="150"
                      Canvas.Top="10"
                      Width="120"
                      Height="120">
                    <Ellipse x:Name="rightEyeBackground"
                             Fill="White"
                             Stroke="Black"
                             StrokeThickness="2"/>
                    <Canvas x:Name="rightPupilCanvas"
                            Width="120"
                            Height="120">
                        <Ellipse x:Name="rightEyePupil"
                                 Width="40"
                                 Height="40"
                                 Fill="Black"
                                 Canvas.Left="40"
                                 Canvas.Top="40"/>
                    </Canvas>
                </Grid>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
